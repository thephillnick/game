def form_connections (i,j):   
    current_node = map[i][j]
    x = screen.get_width() / 2 + ((960/width) * (current_node['id_x'] - ((width - 1)/2)) * 0.8)
    y = screen.get_height() - screen.get_height() * (current_node['id_y']+1) / (height + 2)
    if current_node == map[0][0]:
        x = screen.get_width() / 2
        y = screen.get_height() - 50
    if current_node['type'] != "empty":
        if current_node == map[height - 2][j]:
            x_con = screen.get_width() / 2
            y_con = screen.get_height() - screen.get_height() * (current_node['id_y'] + 1) / (height + 1) - 20
            if (map[i][j]['id_x'],map[i][j]['id_y']) not in in_play_nodes: colour = 'grey'                
            else: colour = 'grey'
            if map[i][j] in route:
                for k in range (width):
                    if map[height - 1][k] in route: colour = 'black'
                    
            pygame.draw.line(screen,colour, (x,y), (x_con, y_con), 5)

        else:
            for k in range (len(current_node['connect'])):
                x_base = current_node['connect'][k][0]
                y_base = current_node['connect'][k][1]
                x_con = screen.get_width() / 2 + ((960/width) * (x_base - ((width - 1)/2)) * 0.8)
                y_con = screen.get_height() - screen.get_height() * (y_base  + 1) / (height + 2)
                if (map[i][j]['id_x'],map[i][j]['id_y']) not in in_play_nodes: colour = 'grey'
                else: colour = 'grey'             
                if map[y_base][x_base] in route and map[i][j] in route: colour = 'black'
                pygame.draw.line(screen,colour, (x,y), (x_con, y_con), 5)


def map_loop (function):
    for i in range (height):
        for j in range (width):
            function(i,j)

def nodes_in_play(current_node):
    if current_node == "tbd": current_node = map[0][0]
    in_play_nodes.clear()
    in_play_nodes.append((0,0))
    start_floor = current_node['id_y']
    in_play_nodes.append((current_node['id_x'],current_node['id_y']))
    for i in range (start_floor, height):
        for j in range (width):
            node = map[i][j]
            if (node['id_x'],node['id_y']) in in_play_nodes:
                for k in range(len(node['connect'])):
                    in_play_nodes.append(node['connect'][k])    
