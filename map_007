                    self.circle_drawn = True
                    map_lock = True

                    if self.node_type == "combat":
                        combat()
                    elif self.node_type == "elite":
                        combat()
                        print ("elite")
                    elif self.node_type == "event":
                        combat()
                    elif self.node_type == "shop":
                        combat()
                    elif self.node_type == "chest":
                        combat()
                    elif self.node_type == "rest":
                        combat()
                    elif self.node_type == "start":
                        combat()
                    elif self.node_type == "end":
                        combat()

                    map_lock = False

                    

                    


    def circle_draw(self):        
        if self.circle_drawn: 
            surface = self.base_surface.copy()
            x = self.circle_surf.get_width() // 2
            y = self.circle_surf.get_height() // 2
            rect = surface.get_rect(center=(x, y))
            self.circle_surf.blit(surface, rect)            
            self.image = self.circle_surf
            self.rect = (self.circle_surf.get_rect(center=(self.x, self.y)))

    def greyed_out_draw(self):
        if (self.current_node['id_x'],self.current_node['id_y']) not in in_play_nodes and not self.circle_drawn:
            self.image = pygame.transform.grayscale(self.image)

       
    def update(self):
        self.node_pressed()
        self.circle_draw()
        self.greyed_out_draw()
        
