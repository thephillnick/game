                    "shop": self.shop_surf,
                    "empty": self.shop_surf,
                    "start": self.start_surf,
                    "end": self.end_surf,
                    }
        scale = 0.8
        self.image = pygame.transform.rotozoom(self.surfaces[f"{self.node_type}"], 0, 0.7)
        self.rect = self.image.get_rect(center = (self.x,self.y))
