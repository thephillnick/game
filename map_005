act1_active = True


# ------------sprites---------
class map_nodes(pygame.sprite.Sprite):
    def __init__(self, i, j):
        super().__init__()
        current_node = map[i][j]
        node_type = current_node['type']
        x = current_node['id_x'] * 100 + 100
        y = screen.get_height() - (current_node['id_y'] * 50 + 70)
        if node_type == "start":
            x = screen.get_width() / 2
            y = screen.get_height() - 40
        if node_type == "end":
            x = screen.get_width() / 2
            y = screen.get_height() - 300
        
        base_path = os.path.dirname(os.path.abspath(__file__))
        self.combat_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "sword.png")).convert_alpha()), 20, 0.05)
        self.elite_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "doublesword.png")).convert_alpha()), 0, 0.05)
        self.event_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "question.png")).convert_alpha()), 0, 0.05)
        self.chest_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "chest.png")).convert_alpha()), 0, 0.05)
        self.shop_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "buy.png")).convert_alpha()), 0, 0.01)
        self.start_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "start.png")).convert_alpha()), 0, 0.2)
        self.end_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "end.png")).convert_alpha()), 0, 0.2)
        surfaces = {"combat": self.combat_surf,
                    "elite": self.elite_surf,
                    "event": self.event_surf,
                    "chest": self.chest_surf,
                    "shop": self.shop_surf,
                    "empty": self.shop_surf,
                    "start": self.start_surf,
                    "end": self.end_surf,
                    }
        self.image = surfaces[f"{node_type}"]
        self.rect = self.image.get_rect(center = (x,y))
            

    def update(self):
        pass



# --------------conections-----------------
def form_connections (i,j):   
    current_node = map[i][j]
    x = map[i][j]["id_x"] * 100 + 100
    y = screen.get_height() - (map[i][j]["id_y"] * 50 + 70)
    if current_node == map[0][0]:
        x = screen.get_width() / 2
        y = screen.get_height() - 40
    if current_node['type'] != "empty":
        if current_node == map[height - 1][j]:
            x_con = screen.get_width() / 2
            y_con = screen.get_height() - 600
            pygame.draw.line(screen,'black', (x,y), (x_con, y_con), 5)
        else:
            for k in range (len(current_node['connect'])):
                x_con = int(current_node['connect'][k][0] * 100 + 100)
                y_con = screen.get_height() - (current_node['connect'][k][1] * 50 + 70)            
                pygame.draw.line(screen,'black', (x,y), (x_con, y_con), 5)

        
def map_loop (function):
    for i in range (height):
        for j in range (width):
            function(i,j)
#----------constants-------------




node_group = pygame.sprite.Group()
for i in range (height):
    for j in range (width):
        if  map[i][j]['type'] != "empty":
            node_group.add(map_nodes(i,j))



running = True
# ----------game----------
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
    pygame.draw.circle(screen,'blue', (200,400), 700)
    map_loop(form_connections)
    node_group.draw(screen)
    node_group.update()


    

    pygame.display.update()
    clock.tick(60)


