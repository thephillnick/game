equation = [-1, 0, 1]

def further_node_connection():
    node_amount = 0
    for j in range (width):
        if map[floor][j]['type'] != "empty":
            node_amount += 1

    for j in range(width):
        current_node = map[floor][j]
        if current_node['type'] == "empty":
            continue

        n = 20 + node_amount
        m = 20 
        num_connections = random.choices((1,2), weights=(n,m))[0]
        attempts = 0

        while len(current_node['connect']) < num_connections and attempts < 20:
            attempts += 1
            offset = random.choice(equation)
            x = j + offset
            if floor == height - 1: x = 0
            y = floor + 1

            if not (0 <= x < width):
                continue
                
            if j > 0 and map[floor][j - 1]['connect']:
                x_list = []
                last_left_target = 0
                for k in range (len(map[floor][j - 1]['connect'])):
                    x_list.append(map[floor][j - 1]['connect'][k][0])
                    last_left_target = max(x_list)
                if x < last_left_target:
                    continue

            add = (x,y)
            if add not in current_node['connect']:
                current_node['connect'].append(add)
            if map[y][x]['type'] == "empty":
                map[y][x]['type'] = 'tbd'
            #------- creating rules--------

            if current_node['type'] == "elite":
                map[y][x]['onmogelijk'].append("elite")
            if current_node['type'] == "shop":
                map[y][x]['onmogelijk'].append("shop")
        

            
    if floor >= height - 1: return floor        
    else: return floor + 1

def further_node_creation():
    combat = 0
    elite = 0
    shop = 0
    event = 0
    chest = 0
    end = 0
    if floor < 3:
        combat = 100
    elif 3 <= floor < 6:
        combat = 100
        elite = 50
        shop = 20
        event = 60
    elif floor == 6:
        chest = 100
    elif 6 < floor < height - 1:
        combat = 100
        elite = 60
        shop = 30
        event = 70
    elif floor == height - 1:
        end = 100

    for j in range (width):
        node_types = ["combat", "elite", "shop", "event","chest" ,"end"]
        weight = [combat,elite,shop,event,chest,end]
        current_node = map[floor][j]
        if current_node['type'] == "empty": 
            continue
        if len(current_node['onmogelijk']) > 0:
            (current_node['onmogelijk']) = list(set(current_node['onmogelijk']))
            for ind in range (len(current_node['onmogelijk'])):
                if current_node['onmogelijk'][ind] == "elite":
                    node_types.remove("elite")
                    weight.remove(elite)
                if current_node['onmogelijk'][ind] == "shop":
                    node_types.remove("shop")
                    weight.remove(shop)        
        current_node['type'] = random.choices(node_types, weights = weight)[0]



