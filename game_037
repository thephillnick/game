        self.card_reward_lock = False
        self.mousepressed = False

    def start_combat(self, type):
        combat_buttons.add(extra_button_nodes(0, ["continue_small"]))
        button_reset()
        for group in combat_buttons:
            if group.type == "continue": group.kill()

        background("battle", (1920,1080))
        combat_buttons.draw(screen)
        self.combat_show = True
        self.map_show = False
        self.deck_show = False
        self.last_scene = self.this_scene
        self.this_scene = "combat"
        player['energy'] = player['total_energy']
        if type == "combat":
            enemie_number = random.randint(1, 4)
            self.current_enemie = enemie_functions[enemie_number](player['roundje']) 
        elif type == "elite":
            enemie_number = random.randint(1, 3)
            self.current_enemie = elite_enemie_functions[enemie_number](player['roundje']) 
        enemie_group.empty()
        for i in range (self.current_enemie['amount']):
            enemie_attributes = ("enemie","hp_bar1","hp_bar2","name","preview")
            if int(self.current_enemie[i]['start_block']) > 0:
                self.current_enemie_attributes.append("shield bar")
            for j in range (len(enemie_attributes)):
                enemie_group.add(enemie_class(enemie_attributes[j], i)  )
        combat_buttons.enemie = self.current_enemie
        player_turn_start()  
          

    def enemie(self):
        return self.current_enemie

    def open(self, type):
        self.scene_false()
        self.last_scene = self.this_scene
        if type == "combat": self.combat_show = True
        if type == "deck": self.deck_show = True
        if type == "discard": self.discard_show = True
        if type == "draw": self.draw_show = True
        if type == "map": self.map_show = True
        if type == "combat": self.combat_show = True
        if type == "reward": self.reward_show = True
        if type == "shop": self.shop_show = True
        self.this_scene = type


    def scene_false(self):
        self.last_scene = self.this_scene
        self.deck_show = False
        self.map_show = False
        self.combat_show = False
        self.draw_show = False
        self.discard_show = False
        self.reward_show = False
        self.shop_show = False

    def turn_switch(self, item):
        if item == "player":
            self.player_turn_active = True
            self.enemie_turn_active = False
        if item == "enemie":
            self.player_turn_active = False
            self.enemie_turn_active = True




