def enemie_turn (roundje):
    enemie = game_state.enemie()
    random_stats["current_enemie"] = 0
    for i in range (enemie["amount"]):
        n = random_stats["current_enemie"]
        if enemie[n]["status"] == "alive":
            if enemie[n]['card_types'] == "attack":
                attack_function, dmg, amount = enemie[n]["attack"][stored[n]["card"]]
                attack_function(dmg, amount, roundje, "no")

            elif enemie[n]["card_types"] == "block":
                block_function, block = enemie[n]["block"][stored[n]["card"]]
                block_function(block, roundje)

            elif enemie[n]["card_types"] == "debuff":
                debuff_function, amount = enemie[n]["debuff"][stored[n]["card"]]
                debuff_function(amount)

            if not enemie[n]["special"] == 0:
                special_function, x = enemie[n]["special"]
                special_function (x)
            else:
                print ("need to add new type")
            
            if enemie[n]["frail"] > 0:
                enemie[n]["frail"] -= 1
            if enemie[n]["vulnerable"] > 0:
                enemie[n]["vulnerable"] -= 1
            if enemie[n]["weak"] > 0:
                enemie[n]["weak"] -= 1

        random_stats["current_enemie"] = (n + 1) % enemie["amount"]
    player["turn"] +=1

