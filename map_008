class map_nodes(pygame.sprite.Sprite):
    def __init__(self, i, j):
        self.circle_drawn = False        
        super().__init__()
        self.current_node = map[i][j]
        self.node_type = self.current_node['type']
        self.x = screen.get_width() / 2 + ((960/width) * (self.current_node['id_x'] - ((width - 1)/2)) * 0.8)
        self.y = screen.get_height() - screen.get_height() * (self.current_node['id_y']+1) / (height + 2)
        if self.node_type == "start":
            self.x = screen.get_width() / 2
            self.y = screen.get_height() - 50
        if self.node_type == "end":
            self.x = screen.get_width() / 2
            self.y = screen.get_height() - screen.get_height() * (self.current_node['id_y']+1) / (height + 1)
        
        base_path = os.path.dirname(os.path.abspath(__file__))
        self.combat_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "sword.png")).convert_alpha()), 20, 0.1)
        self.elite_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "doublesword.png")).convert_alpha()), 0, 0.1)
        self.event_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "question.png")).convert_alpha()), 0, 0.1)
        self.chest_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "chest.png")).convert_alpha()), 0, 0.1)
        self.shop_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "buy.png")).convert_alpha()), 0, 0.02)
        self.start_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "start.png")).convert_alpha()), 0, 0.4)
        self.end_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "end.png")).convert_alpha()), 0, 0.6)
        self.surfaces = {"combat": self.combat_surf,
                    "elite": self.elite_surf,
                    "event": self.event_surf,
                    "chest": self.chest_surf,
                    "shop": self.shop_surf,
                    "empty": self.shop_surf,
                    "start": self.start_surf,
                    "end": self.end_surf,
                    }
        scale = 0.8
        self.image = pygame.transform.rotozoom(self.surfaces[f"{self.node_type}"], 0, 0.7)
        self.rect = self.image.get_rect(center = (self.x,self.y))
        self.base_surface = self.image.copy()



        #other_surfaces
        if self.node_type in ["combat", "event", "elite", "shop", "chest"]:
            scale = 0.3 * 0.7
        else:
            scale = 0.6
        self.circle_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "circle.png")).convert_alpha()), 0, scale)
        circle_x = self.base_surface.get_width() // 2
        circle_y = self.base_surface.get_height() // 2
        self.circle_rect = self.circle_surf.get_rect(center=(circle_x, circle_y))

    def node_pressed(self):
        global playing_floor
        global map_lock
        if pygame.mouse.get_pressed() == (1,0,0):
            mouse_pos = pygame.mouse.get_pos()
            if self.rect.collidepoint(mouse_pos):
                node = self.current_node
                if node['id_y'] == playing_floor and (node['id_x'],node['id_y']) in in_play_nodes and not map_lock:
                    print(node['id_x'],node['id_y'], node['type'])
                    playing_floor += 1
                    route.append(node)
                    nodes_in_play(node)
                    self.circle_drawn = True
                    map_lock = True
                    
                    if self.node_type == "combat":
                        game_state.start_combat()
                    elif self.node_type == "elite":
                        game_state.start_elite()
                    elif self.node_type == "event":
                        pass
                    elif self.node_type == "shop":
                        pass
                    elif self.node_type == "chest":
                        pass
                    elif self.node_type == "rest":
                        pass
                    elif self.node_type == "start":
                        pass
                    elif self.node_type == "end":
                        pass

                    map_lock = False


                    

                    


    def circle_draw(self):        
        if self.circle_drawn: 
            surface = self.base_surface.copy()
            x = self.circle_surf.get_width() // 2
            y = self.circle_surf.get_height() // 2
            rect = surface.get_rect(center=(x, y))
            self.circle_surf.blit(surface, rect)            
            self.image = self.circle_surf
            self.rect = (self.circle_surf.get_rect(center=(self.x, self.y)))

    def greyed_out_draw(self):
        if (self.current_node['id_x'],self.current_node['id_y']) not in in_play_nodes and not self.circle_drawn:
            self.image = pygame.transform.grayscale(self.image)

       
    def update(self):
        self.node_pressed()
        self.circle_draw()
        self.greyed_out_draw()
        
