def background(type, scale):
    base_path = os.path.dirname(os.path.abspath(__file__))
    wood_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "wood_background.jpg")).convert_alpha()), 90, 1)
    paper_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "paper_background.jpg")).convert_alpha()), 0, 1)
    battle_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "battle_background.jpg")).convert_alpha()), 0, 1)
    card_surf = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "card_background.jpg")).convert_alpha()), 0, 1)
    x = screen.get_width() / 2
    y = screen.get_height() / 2
    if type == "wood":
        surface = wood_surf
    if type == "map":
        surface = paper_surf
    if type == "battle":
        surface = battle_surf
    if type == "card":
        surface = card_surf
    resised_surface = pygame.transform.smoothscale(surface, scale)
    resised_rect = resised_surface.get_rect(center = (x,y))
    screen.blit(resised_surface, resised_rect)

