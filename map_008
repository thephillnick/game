class player_class(pygame.sprite.Sprite):
    def __init__(self, part):
        super().__init__()
        self.max_hp = 100
        self.hp = 100
        x_cord = 300
        y_cord = 600
        self.bar_width = 150
        self.bar_height = 20
        base_path = os.path.dirname(os.path.abspath(__file__))
        player = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "player.png")).convert_alpha()), 0, 0.15)
        player_strike = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "player.strike.png")).convert_alpha()), 0, 0.15)

        hp_bar = pygame.transform.rotozoom((pygame.image.load(os.path.join(base_path, "game_images", "bar.png")).convert_alpha()), 0, 0.15)
        green_surf = pygame.image.load(os.path.join(base_path, "game_images", "health_bar.png"))

        if part == "player":
            print ("player")
            surfaces = ["player", "player_strike"]
            dic = {"player": player,
                    "player_strike": player_strike}
            self.image = dic[surfaces[1]]
            self.rect = self.image.get_rect(midbottom = (x_cord,y_cord))

        if part == "hp_bar1":           
            hp_bar_frame = pygame.transform.smoothscale(hp_bar, (self.bar_width, self.bar_height))
            
            self.image = hp_bar_frame
            self.rect = self.image.get_rect(bottomleft = (x_cord - 30, y_cord + 50))

        if part == "hp_bar2":
            health_bar = pygame.transform.smoothscale(hp_bar, (self.bar_width, self.bar_height))
            ratio = self.hp / self.max_hp 
            green_width = int(self.bar_width * ratio)

            crop_rect = pygame.Rect(0, 0, green_width, self.bar_height)
            cropped_image = health_bar.subsurface(crop_rect)
            self.image = cropped_image
            self.rect = self.image.get_rect(bottomleft = (x_cord - 30, y_cord + 50))

    def hp_bar_update(self):
        self.max_hp = player['max_hp']
        self.hp = max(0, player['hp'])

    def update(self):
        self.hp_bar_update()


