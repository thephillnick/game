class player_sprite(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        player_surface1 = pygame.image.load('C:/Users/loicw/pygame_test/player_walk_1.png').convert_alpha()
        player_surface2 = pygame.image.load('C:/Users/loicw/pygame_test/player_walk_2.png').convert_alpha()
        self.player_walk = [player_surface1, player_surface2]
        self.player_index = 0
        self.player_jump = pygame.image.load('C:/Users/loicw/pygame_test/jump.png').convert_alpha()

        self.image = self.player_walk[self.player_index]
        self.rect = self.image.get_rect(midbottom = (200,300))
        self.gravity = 0
    def player_input(self):
        keys = pygame.key.get_pressed()
        if keys[pygame.K_SPACE] and self.rect.bottom == 300:
            self.gravity -= 20

    def apply_gravity(self):
        self.rect.y += self.gravity
        if self.rect.bottom < 300:
            self.gravity += 1
        if self.rect.bottom > 300:
            self.rect.bottom = 300

    def animation(self):
        if self.rect.bottom < 300:
            self.image = self.player_jump
        else:
            self.player_index += 0.1
            if self.player_index >= len(self.player_walk): self.player_index = 0
            self.image = self.player_walk[int(self.player_index)]
    def update(self):
        self.player_input()
        self.apply_gravity()
        self.animation()

class obstacle(pygame.sprite.Sprite):
    def __init__(self, type):
        super().__init__()
        self.animation_index = 0
        if type == "fly":
            fly_1 = pygame.image.load('C:/Users/loicw/pygame_test/fly1.png')
            fly_2 = pygame.image.load('C:/Users/loicw/pygame_test/fly2.png')
            self.frames = [fly_1,fly_2]
            self.y = 200
        if type == "snail":
            snail_1 = pygame.image.load('C:/Users/loicw/pygame_test/snail1.png').convert_alpha()
            snail_2 = pygame.image.load('C:/Users/loicw/pygame_test/snail2.png').convert_alpha()
            self.frames = [snail_1,snail_2]
            self.y = 300

        self.animation_index = 0
        self.image = self.frames[self.animation_index]
        self.rect = self.image.get_rect(bottomleft = (random.randint(900,1100), self.y))

    def animation(self):
        self.animation_index += 0.1
        if self.animation_index >= len(self.frames): self.animation_index = 0
        self.image = self.frames[int(self.animation_index)]

    def update(self):
        self.animation()
        self.rect.x -= 6
        self.destroy()

    def destroy(self):
        if self.rect.x <= -100:
            self.kill()

    
