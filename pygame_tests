def obstacle_movement(obstacle_list):
    if obstacle_list:
        for obstacle_rect in obstacle_list:
            obstacle_rect.x -= 5
            if obstacle_rect.bottom == 300:
                screen.blit(snail1, obstacle_rect)
            else:
                screen.blit(bat_surf, obstacle_rect)
        obstacle_list = [obstacle for obstacle in obstacle_list if obstacle.x > -100]
        return obstacle_list
    else: return[]

def collission_check(game_active, end_time, start_time):
    for obstacle in obstacle_rect_list:
        if player_rect.colliderect(obstacle):
            game_active = False
            end_time = pygame.time.get_ticks() - start_time
            obstacle_rect_list.clear()

    return game_active, end_time

