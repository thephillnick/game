#----------------card_effects--------------
def p_normal_attack(dmg, n):
    enemie = game_state.enemie()
    vul = 1
    weak = 1
    if enemie[n]["vulnerable"] > 0:
        vul = 3/2
    if player["weak"] > 0:
        weak = 3/4
    total_dmg = round((dmg + player["strength"]) * vul * weak)
    if enemie[n]["start_block"] >= total_dmg:
        enemie[n]["start_block"] = enemie[n]["start_block"] - total_dmg

    else:
        enemie[n]["enemie_hp"] = enemie[n]["enemie_hp"] + enemie[n]["start_block"]
        enemie[n]["start_block"] = 0
        enemie[n]["enemie_hp"] = enemie[n]["enemie_hp"] - total_dmg
    print (f"{player_name} has done {total_dmg} damage")
    stats_game["damage dealt"] += total_dmg

def P_normal_multi_attack(dmg,amount, n):
    enemie = game_state.enemie()
    vul = 1
    weak = 1
    if enemie[n]["vulnerable"] > 0:
        vul = 3/2
    if player["weak"] > 0:
        weak = 3/4
    total_dmg = round((dmg + player["strength"])* weak * vul) * amount
    if enemie[n]["start_block"] >= total_dmg:
        enemie[n]["start_block"] = enemie[n]["start_block"] - total_dmg

    else:
        enemie[n]["enemie_hp"] = enemie[n]["enemie_hp"] + enemie[n]["start_block"]
        enemie[n]["start_block"] = 0
        enemie[n]["enemie_hp"] = enemie[n]["enemie_hp"] - total_dmg
    print (f"{player_name} has done {(dmg + player["strength"]) * weak * vul} damage {amount} times")
    stats_game["damage dealt"] += total_dmg


